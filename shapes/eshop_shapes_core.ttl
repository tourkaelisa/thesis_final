@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pto: <http://www.productontology.org/id/> .
@prefix gr: <http://purl.org/goodrelations/v1#> .
@prefix schema: <http://schema.org/> .
@prefix eshop: <http://www.myeshop.gr/resource/> .
@prefix prop: <http://www.myeshop.gr/property/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Κοινοί υποχρεωτικοί κανόνες για όλα τα προϊόντα
# Ελέγχονται μόνο τα κύρια χαρακτηριστικά που παράγονται

eshop:GlobalProductShape a sh:NodeShape ;
    sh:targetClass gr:ProductOrService ;

    sh:property [
        sh:path schema:price ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:message "Το προϊόν δεν διαθέτει έγκυρη τιμή." ;
    ] ;
    sh:property [
        sh:path schema:priceCurrency ;
        sh:minCount 1 ;
        sh:hasValue "EUR" ;
        sh:message "Λείπει το νόμισμα ή δεν είναι EUR." ;
    ] ;
    sh:property [
        sh:path gr:name ;
        sh:minCount 1 ;
        sh:message "Λείπει το όνομα του προϊόντος." ;
    ] ;
    sh:property [
        sh:path schema:image ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Λείπει η εικόνα του προϊόντος." ;
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Λείπει το URL του προϊόντος." ;
    ] ;
    sh:property [
        sh:path schema:manufacturer ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Λείπει ο κατασκευαστής του προϊόντος." ;
    ] .

# ΚΑΝΟΝΕΣ ΑΝΑ ΚΑΤΗΓΟΡΙΑ (για τα χαρακτηριστικά τα οποία δεν έχουν όλα τα προϊόντα της κατηγορίας δεν δημιουργήθηκε αντίστοιχος κανόνας )

eshop:LaptopShape a sh:NodeShape ;
    sh:targetClass pto:Laptop ;
    sh:property [ sh:path rdf:type ; sh:hasValue gr:ProductOrService ; sh:message "Το laptop δεν έχει δηλωθεί ως gr:ProductOrService." ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue pto:Laptop ; sh:message "Το laptop δεν έχει δηλωθεί ως pto:Laptop." ] ;
    sh:property [ sh:path schema:operatingSystem ; sh:minCount 1 ; sh:message "Λείπει το λειτουργικό σύστημα του laptop." ] ;
    sh:property [ sh:path prop:cpu_model ; sh:minCount 1 ; sh:message "Λείπει το μοντέλο CPU του laptop." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_ram$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει η μνήμη RAM του laptop." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_storage$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει ο αποθηκευτικός χώρος του laptop." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_screen_size$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το μέγεθος οθόνης του laptop." ] ;
    sh:property [ sh:path schema:color ; sh:minCount 1 ; sh:message "Λείπει το χρώμα του laptop." ] ;
    sh:property [ sh:path schema:releaseDate ; sh:minCount 1 ; sh:message "Λείπει το έτος κυκλοφορίας του laptop." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_refresh_rate$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει ο ρυθμός ανανέωσης του laptop." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_resolution_width$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το πλάτος ανάλυσης οθόνης του laptop." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_resolution_height$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το ύψος ανάλυσης οθόνης του laptop." ] .

eshop:SmartphoneShape a sh:NodeShape ;
    sh:targetClass pto:Smartphone ;
    sh:property [ sh:path rdf:type ; sh:hasValue gr:ProductOrService ; sh:message "Το κινητό δεν έχει δηλωθεί ως gr:ProductOrService." ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue pto:Smartphone ; sh:message "Το κινητό δεν έχει δηλωθεί ως pto:Smartphone." ] ;
    sh:property [ sh:path schema:operatingSystem ; sh:minCount 1 ; sh:message "Λείπει το λειτουργικό σύστημα του κινητού." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_storage$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει ο αποθηκευτικός χώρος του κινητού." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_battery$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει η χωρητικότητα μπαταρίας του κινητού." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_screen_size$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το μέγεθος οθόνης του κινητού." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_camera_main_mp$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει η κύρια κάμερα του κινητού." ] ;
    sh:property [ sh:path schema:color ; sh:minCount 1 ; sh:message "Λείπει το χρώμα του κινητού." ] ;
    sh:property [ sh:path schema:releaseDate ; sh:minCount 1 ; sh:message "Λείπει το έτος κυκλοφορίας του κινητού." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_weight$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το βάρος του κινητού." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_resolution_width$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το πλάτος ανάλυσης οθόνης του κινητού." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_resolution_height$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το ύψος ανάλυσης οθόνης του κινητού." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_camera_selfie_mp$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει η selfie κάμερα του κινητού." ] .

eshop:TabletShape a sh:NodeShape ;
    sh:targetClass pto:Tablet_computer ;
    sh:property [ sh:path rdf:type ; sh:hasValue gr:ProductOrService ; sh:message "Το tablet δεν έχει δηλωθεί ως gr:ProductOrService." ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue pto:Tablet_computer ; sh:message "Το tablet δεν έχει δηλωθεί ως pto:Tablet_computer." ] ;
    sh:property [ sh:path schema:operatingSystem ; sh:minCount 1 ; sh:message "Λείπει το λειτουργικό σύστημα του tablet." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_ram$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει η μνήμη RAM του tablet." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_storage$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει ο αποθηκευτικός χώρος του tablet." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_screen_size$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το μέγεθος οθόνης του tablet." ] ;
    sh:property [ sh:path schema:color ; sh:minCount 1 ; sh:message "Λείπει το χρώμα του tablet." ] ;
    sh:property [ sh:path schema:releaseDate ; sh:minCount 1 ; sh:message "Λείπει το έτος κυκλοφορίας του tablet." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_weight$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το βάρος του tablet." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_resolution_width$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το πλάτος ανάλυσης οθόνης του tablet." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_resolution_height$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το ύψος ανάλυσης οθόνης του tablet." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_camera_main_mp$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει η κύρια κάμερα του tablet." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_camera_selfie_mp$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει η selfie κάμερα του tablet." ] .

eshop:TelevisionShape a sh:NodeShape ;
    sh:targetClass pto:Television_set ;
    sh:property [ sh:path rdf:type ; sh:hasValue gr:ProductOrService ; sh:message "Η τηλεόραση δεν έχει δηλωθεί ως gr:ProductOrService." ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue pto:Television_set ; sh:message "Η τηλεόραση δεν έχει δηλωθεί ως pto:Television_set." ] ;
    sh:property [ sh:path schema:operatingSystem ; sh:minCount 1 ; sh:message "Λείπει το λειτουργικό σύστημα της τηλεόρασης." ] ;
    sh:property [ sh:path prop:definition ; sh:minCount 1 ; sh:message "Λείπει η ευκρίνεια (definition) της τηλεόρασης." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_screen_size$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει το μέγεθος οθόνης της τηλεόρασης." ] ;
    sh:property [ sh:path gr:quantitativeProductOrServiceProperty ; sh:qualifiedValueShape [ sh:pattern "_refresh_rate$" ] ; sh:qualifiedMinCount 1 ; sh:message "Λείπει ο ρυθμός ανανέωσης της τηλεόρασης." ] ;
    sh:property [ sh:path schema:releaseDate ; sh:minCount 1 ; sh:message "Λείπει το έτος κυκλοφορίας της τηλεόρασης." ] .

eshop:SmartwatchShape a sh:NodeShape ;
    sh:targetClass pto:Smartwatch ;
    sh:property [ sh:path rdf:type ; sh:hasValue gr:ProductOrService ; sh:message "Το smartwatch δεν έχει δηλωθεί ως gr:ProductOrService." ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue pto:Smartwatch ; sh:message "Το smartwatch δεν έχει δηλωθεί ως pto:Smartwatch." ] ;
    sh:property [ sh:path schema:operatingSystem ; sh:minCount 1 ; sh:message "Λείπει το λειτουργικό σύστημα του smartwatch." ] ;
    sh:property [ sh:path schema:color ; sh:minCount 1 ; sh:message "Λείπει το χρώμα του smartwatch." ] .

